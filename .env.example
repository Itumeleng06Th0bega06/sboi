# ---------------------------------------------------------------------------
# Shekinah Blaze — environment variables (Render.com)
# Copy this file to `.env` locally for smoke-testing prod settings.
# On Render, set these in the Web Service -> Environment panel (never in git).
# ---------------------------------------------------------------------------

# REQUIRED
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Render Postgres "Internal Database URL" (starts with postgres://)
# Use a REAL value here locally (copy from Render -> Connections) — never commit a real password.
DATABASE_URL=

# REQUIRED for the admin to work over HTTPS
ALLOWED_HOSTS=shekinahblaze.org,www.shekinahblaze.org,.onrender.com
CSRF_TRUSTED_ORIGINS=https://shekinahblaze.org,https://www.shekinahblaze.org,https://*.onrender.com

# REQUIRED — secret admin path (e.g. blaze-admin-9x2k). Do NOT reuse this example.
ADMIN_URL=

# REQUIRED — Cloudinary media storage (free account: https://cloudinary.com → Dashboard)
# The cloud name appears in your Dashboard URL (e.g. https://res.cloudinary.com/<cloud-name>/).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — auto-create the admin superuser on deploy (superuser is only
# created when SUPERUSER_EMAIL is set).
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=

# Optional
# SECURE_SSL_REDIRECT
# SMTP_HOST
# SMTP_PORT
# SMTP_USER
# SMTP_PASSWORD
# SMTP_USE_TLS
# DEFAULT_FROM_EMAIL