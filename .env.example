# ===========================================================================
# PRODUCTION environment — SHEKINAH BLAZE (cPanel / MariaDB)
# ===========================================================================
#
# This template is the *production* configuration. Copy it to `.env` in the
# project root and fill in the real values:
#
#     cp .env.example .env
#
# `.env` is read by `sboi/settings_prod.py`, which is the settings module the
# live site uses (Passenger loads it via passenger_wsgi.py). NEVER commit the
# real `.env` to git — it is already git-ignored.
#
# Which settings module is which?
#   * sboi.settings       -> local DEVELOPMENT (SQLite, DEBUG=True). No .env.
#   * sboi.settings_prod  -> PRODUCTION (MariaDB, DEBUG=False, public_html).
#                            This is the one used on cPanel.
# ===========================================================================

# REQUIRED — long random string.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# REQUIRED — MariaDB database created in cPanel -> MySQL Databases.
# On cPanel the host is almost always "localhost" and the database/user names
# are prefixed with your account name, e.g. shekinah_sboi.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
# Persistent DB connections: leave 0 on shared hosting (connection limits).
DB_CONN_MAX_AGE=0

# REQUIRED — the domains Django is allowed to serve.
# A leading dot matches the domain AND every subdomain (mail., cpanel., www., …).
# "mail.shekinahblaze.org" is listed explicitly too because cPanel's
# "Setup Python App" preview often opens the app on the mail subdomain.
ALLOWED_HOSTS=shekinahblaze.org,www.shekinahblaze.org,mail.shekinahblaze.org,.shekinahblaze.org
CSRF_TRUSTED_ORIGINS=https://shekinahblaze.org,https://www.shekinahblaze.org,https://mail.shekinahblaze.org

# REQUIRED — secret admin path (e.g. blaze-admin-9x2k). Do NOT reuse this example.
ADMIN_URL=

# Uploaded media is served by Apache from the cPanel web root. Static files are
# collected into the project's staticfiles/ folder and served by WhiteNoise, so
# they are not affected by this. Set this to the output of
#   python -c "from pathlib import Path; print(Path.home() / 'public_html')"
# if it is not picked up automatically.
# PUBLIC_HTML=/home1/shekinah/public_html

# Set to false if cPanel's HTTPS redirect causes a redirect loop.
# SECURE_SSL_REDIRECT=true

# Optional — used by superuser.py to create the first admin without a terminal.
# If left blank, the fallbacks inside superuser.py are used instead.
SUPERUSER_USERNAME=
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=

# Optional — outgoing email (contact messages are stored in the DB regardless)
# Address used for admin/error reports and as the site's outgoing "from".
ADMIN_EMAIL=admin@shekinahblaze.org
# SMTP_HOST
# SMTP_PORT=587
# SMTP_USER
# SMTP_PASSWORD
# SMTP_USE_TLS=true
# DEFAULT_FROM_EMAIL=Shekinah Blaze <admin@shekinahblaze.org>
