# ---------------------------------------------------------------------------
# Shekinah Blaze — production environment variables (Render.com)
# Copy this file to `.env` locally for smoke-testing prod settings.
# On Render, set these in the Web Service -> Environment panel (never in git).
# ---------------------------------------------------------------------------

# REQUIRED
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-string

# Render Postgres "Internal Database URL" (starts with postgres://)
DATABASE_URL=postgresql://sboi_db_user:rlOlnC5PzqXFGlSeW9I3aoWgLvpqQN9d@dpg-d9vf8b142hec738touu0-a.ohio-postgres.render.com/sboi_db

# REQUIRED for media uploads (Backblaze B2 application key or Cloudflare R2 token)
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_STORAGE_BUCKET_NAME=replace-me
AWS_S3_REGION_NAME=replace-me
# B2 example:  https://s3.us-west-004.backblazeb2.com
# R2 example:  https://<accountid>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=replace-me
# Optional: serve media from a custom subdomain (e.g. media.shekinahblaze.org)
# AWS_S3_CUSTOM_DOMAIN=media.shekinahblaze.org

# REQUIRED for the admin to work over HTTPS
ALLOWED_HOSTS=shekinahblaze.org,www.shekinahblaze.org,.onrender.com
CSRF_TRUSTED_ORIGINS=https://shekinahblaze.org,https://www.shekinahblaze.org,https://*.onrender.com

# REQUIRED — secret admin path (e.g. shekinah-fire-9x2k). Do NOT reuse this example.
ADMIN_URL=shekinah-fire-9x2k

# Optional
# SECURE_SSL_REDIRECT=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=app-password
# SMTP_USE_TLS=true
# DEFAULT_FROM_EMAIL=Shekinah Blaze <no-reply@shekinahblaze.org>